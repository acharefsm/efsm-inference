	"version": "0.2.0",
	"configurations": [

		{
			"name": "generalise",
			"type": "debugpy",
			"cwd": "${workspaceFolder}/sample-traces/drinks/",
			"request": "launch",
			"module": "gp_generalise",
			"console": "integratedTerminal",
			"args": "-c drinks_register_guard_bounded_inferred.sampled.dot -t drinks_register_guard_bounded_inferred.simulation.csv"
		},
		
		{
			"name": "debug python",
			"type": "debugpy",
			"request": "launch",
			"program": "${file}",
			"console": "integratedTerminal",
			"args": "${command:pickArgs}"
		},
		
		{
			
			"name": "generalise scala",
			"type": "scala",
			"request": "launch",
			"mainClass": "FrontEnd",
			"args": [
				"--pta",
				"${workspaceFolder}/sample-traces/drinks/drinks_register_guard_bounded_inferred.sampled_generalised.json",
				"-h",
				"distinguish",
				"${workspaceFolder}/sample-traces/drinks_register_guard_bounded_inferred.simulation_new_trace.json",
				"${workspaceFolder}/sample-traces/drinks_register_guard_bounded_inferred.simulation_new_trace.json",
			],
			"jvmOptions": [
				"-Djna.library.path=C:\\Users\\vega\\AppData\\Local\\Programs\\Python\\Python39",
				"-Djna.debug_load=true",
				"-Dscalapy.python.library=python39"
			],
			"env": {}
		}
	]
}